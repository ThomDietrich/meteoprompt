# Copy to .env and fill in real secrets. .env is gitignored.
# Both secrets are server-only — never expose them to the client (no NEXT_PUBLIC_*).
INFLUXDB_URL=https://your-influxdb-host:8086
INFLUXDB_ORG=your-org
INFLUXDB_BUCKET=your-bucket
INFLUXDB_TOKEN=__HIER_READ_TOKEN_EINSETZEN__
# Optional (spec-17): HTTP-Timeout des InfluxDB-Clients in ms. Ohne Angabe 45000.
# INFLUXDB_TIMEOUT_MS=45000

# Anthropic (Claude) — used server-side by /api/ask for NL → QuerySpec (tool use).
ANTHROPIC_API_KEY=__HIER_ANTHROPIC_KEY_EINSETZEN__

# Impressum (Anbieterkennzeichnung) — rendered on /impressum at runtime.
# Keep real personal/address data OUT of the repo; set these in .env only.
IMPRESSUM_NAME=Vorname Nachname
IMPRESSUM_STREET=Straße Hausnummer
IMPRESSUM_CITY=PLZ Ort
IMPRESSUM_EMAIL=kontakt@example.com

# Branding — general by default; set your own per deployment.
#   SITE_NAME    — on-page wordmark (header/footer) + browser window title.
#   APP_NAME     — installed-app / home-screen name (PWA manifest + Apple). Optional;
#                  defaults to SITE_NAME. Set it to sort the app where users expect,
#                  e.g. APP_NAME="Wetter Musterstadt – MeteoPrompt" → listed under "W".
#   SITE_TAGLINE — subtitle under the wordmark + page-title suffix.
SITE_NAME=MeteoPrompt
APP_NAME=MeteoPrompt
SITE_TAGLINE=Wetterdaten per Prompt erkunden
